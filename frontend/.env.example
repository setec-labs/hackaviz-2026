# Source des trajets : "mock" (defaut, aucun backend requis) ou "api" (service routing).
VITE_DATA_SOURCE=mock

# Source de l'indice de securite : "api" (defaut, service safety) ou "mock".
VITE_SAFETY_SOURCE=api

# URL de base des API FastAPI (utilisees uniquement pour les sources "api").
VITE_TRIPS_API_URL=http://localhost:8001
VITE_SAFETY_API_URL=http://localhost:8002

# Nombre de trajets simules generes par le mock (surchargeable avec ?trips=3000 dans l'URL).
VITE_MOCK_TRIP_COUNT=250
